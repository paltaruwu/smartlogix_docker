# URL del API Gateway (Spring Cloud Gateway). En local: http://localhost:8089
# En EC2: http://IP_PUBLICA_EC2:8089  (o el dominio/puerto que expongas)
VITE_API_URL=http://localhost:8089

# Datos del App Registration creado en Azure Entra ID (portal.azure.com)
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Debe coincidir EXACTO con un "Redirect URI" (tipo SPA) configurado en el App Registration.
# En local: http://localhost:5173
# En EC2:   http://IP_PUBLICA_EC2:PUERTO_FRONTEND (o tu dominio)
VITE_AZURE_REDIRECT_URI=http://localhost:5173
